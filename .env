# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL Localhost)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=12345
DB_NAME=E-Commerce-DB

# Authentication
# Run `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"` in your terminal to generate a strong key
JWT_SECRET=your_generated_jwt_secret_key
JWT_EXPIRES_IN=7d

# MercadoPago Integration (Sandbox Mode)
MP_ACCESS_TOKEN=your_mercadopago_test_access_token